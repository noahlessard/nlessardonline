---
import { Image } from 'astro:assets';
import Link from '../components/link.astro';
interface Props {
    image: ImageMetadata;
    link: string;
}
const { image, link } = Astro.props;
const project = await import(`../pages/projects/${link}.mdx`);
---
<div class="project-listing">
    <Link href={`projects/${link}`}>
    <Image 
        src={image}
        alt={project.frontmatter.title} 
        class="project-cover"
        width={400}
        loading="eager"
    />
    <div class="project-info">
        <h3>{project.frontmatter.title}</h3>
        <p class="description">
            {project.frontmatter.description ? project.frontmatter.description : <slot />}
        </p>
    </div>
    </Link>
</div>
<style>
    
    .project-listing {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1rem;
        margin: 1rem 0;
        transition: opacity 0.15s ease;
    }

    .project-listing:hover {
    opacity: 0.8;
    }
     
    .project-listing a {
        color: inherit;
        text-decoration: none;
        display: contents;
    }
    
    .project-cover {
        width: 120px;
        height: auto;
        object-fit: cover;
        border-radius: 4px;
        flex-shrink: 0; 
    }
    
    .project-info {
        flex: 1;
    }
    
    .project-info h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.5rem;
    }
    
    .description {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
    }
    
    .rating {
        margin: 0;
        font-style: italic;
        font-size: 0.85rem;
    }

    @media (max-width: 800px) {
        .project-listing {
            flex-direction: column;
            text-align: center;
        }
        
        .project-cover {
            width: 160px;
        }
    }
</style>